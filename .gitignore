# =====================================================================
# .gitignore untuk Proyek EduSense (Python AI + Flutter Mobile)
# =====================================================================

# 1. Lingkungan Virtual Python (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Bytecode & Cache Python
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.mypy_cache/
.pytype/

# 3. File Arsip Dataset Besar
*.zip
*.tar.gz
*.rar
*.7z

# 4. Folder Hasil Percobaan & Tangkapan Layar Webcam
dataset/raw/hasil_percobaan_kamera/screenshot_*.jpg
hasil_percobaan_kamera/screenshot_*.jpg

# 5. Output Pelatihan YOLO & Checkpoint Sementara
runs/
*.epoch
last.pt

# 6. Flutter & Dart (Mobile App)
frontend/.dart_tool/
frontend/build/
frontend/android/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/android/.gradle/
frontend/android/local.properties
frontend/ios/.symlinks/
frontend/ios/Pods/
frontend/ios/Podfile.lock
edusense_mobile/.dart_tool/
edusense_mobile/build/

# 7. File Konfigurasi Editor / IDE & OS
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# 8. Kredensial layanan backend
backend/.env
