{
  "/* ========================================================================== */": "ATURAN KEAMANAN FIREBASE REALTIME DATABASE (EDUSENSE SMART CLASSROOM)",
  "/* CARA PASANG:                                                               */": "Buka Firebase Console -> Realtime Database -> Tab 'Rules' -> Paste kode ini -> Publish",
  "/* SINKRONISASI: Menghubungkan Mobile App Flutter, Hardware ESP32, & Backend  */": "Seluruh node diamankan dengan standar autentikasi auth != null.",
  "rules": {
    "dosen": {
      "/* Profil dosen hanya dapat dibaca dan diubah oleh akun terautentikasi */": "",
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true",
      "$nip": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },

    "mahasiswa": {
      "/* Daftar mahasiswa kelas terdaftar */": "",
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.admin === true || auth != null)"
    },

    "registrasi_wajah": {
      "/* Sampel foto registrasi wajah mahasiswa untuk absensi */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "presensi": {
      "/* Log presensi kelas harian real-time */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "riwayat_presensi": {
      "/* Riwayat kejadian presensi per mahasiswa (Hadir, Terlambat, Sakit, Izin, Tidur) */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "pelaporan_tidur_harian": {
      "/* Arsip pelaporan akumulasi durasi tidur harian jika lewat 1 hari */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "monitoring": {
      "/* Sesi monitoring kelas real-time dari Vision AI / CCTV */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "alert_tidur": {
      "/* Notifikasi peringatan saat mahasiswa terdeteksi tertidur */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "iot": {
      "/* Telemetri sensor DHT22 & kontrol kipas IoT */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "iot_ruangan": {
      "/* Kontrol kipas dan sensor per ruangan kelas/lab */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "log_kontrol_kipas": {
      "/* Rekam jejak perubahan mode dan kecepatan kipas */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
