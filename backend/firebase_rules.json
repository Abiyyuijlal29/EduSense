{
  "/* ========================================================================== */": "ATURAN KEAMANAN FIREBASE REALTIME DATABASE (EDUSENSE)",
  "/* CARA PASANG:                                                               */": "Buka Firebase Console -> Realtime Database -> Tab 'Rules' -> Paste kode ini -> Publish",
  "/* PRINSIP: Data hanya dapat diakses oleh user yang sudah Login (auth != null).*/": "Mencegah database dibaca atau diubah oleh pihak luar yang tidak dikenal.",
  "rules": {
    "dosen": {
      "/* Hanya dosen yang sudah login dapat membaca data profil dosen */": "",
      ".read": "auth != null",
      "/* Data dosen hanya boleh diubah oleh admin / service account server */": "",
      ".write": "auth != null && auth.token.admin === true"
    },

    "mahasiswa": {
      "/* Daftar mahasiswa hanya boleh dibaca oleh pengguna yang sudah terautentikasi */": "",
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },

    "registrasi_wajah": {
      "/* Data sampel registrasi wajah mahasiswa untuk absensi */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "presensi": {
      "/* Log presensi kelas harian */": "",
      ".read": "auth != null",
      "/* Dosen atau server dapat mencatat/memperbarui status kehadiran */": "",
      ".write": "auth != null"
    },

    "monitoring": {
      "/* Sesi monitoring kelas real-time (jumlah memperhatikan / tertidur) */": "",
      ".read": "auth != null",
      "/* Ditulis secara berkala oleh server AI Vision atau klien terautentikasi */": "",
      ".write": "auth != null"
    },

    "alert_tidur": {
      "/* Notifikasi peringatan saat mahasiswa tertidur terdeteksi */": "",
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "iot": {
      "/* Data telemetri sensor suhu, kelembaban, dan status kipas */": "",
      ".read": "auth != null",
      "/* Dosen terautentikasi dapat mengubah kontrol kipas (Auto/Manual) */": "",
      ".write": "auth != null"
    },

    "iot_ruangan": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
